		<kernel-biosdk-provider.version>1.4.1-SNAPSHOT</kernel-biosdk-provider.version>
		<id-repository-core.version>1.4.1-SNAPSHOT</id-repository-core.version>
		<json.utility.version>20180130</json.utility.version>
		<kernel-biometrics-util.version>1.4.1-SNAPSHOT</kernel-biometrics-util.version>
